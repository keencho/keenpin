[
  {
    "label": "keenpin: run",
    "command": "cargo",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "allow_concurrent_runs": false,
    "use_new_terminal": false
  },
  {
    "label": "keenpin: run (release)",
    "command": "cargo",
    "args": ["run", "--release"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "allow_concurrent_runs": false,
    "use_new_terminal": false
  },
  {
    "label": "keenpin: build",
    "command": "cargo",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "keenpin: 안전 경계 검사",
    "command": "cargo",
    "args": ["test", "--test", "boundary", "--", "--nocapture"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "tags": ["safety"]
  },
  {
    "label": "keenpin: test (all)",
    "command": "cargo",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "keenpin: clippy",
    "command": "cargo",
    "args": ["clippy", "--all-targets", "--", "-D", "warnings"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
  {
    "label": "keenpin: fmt",
    "command": "cargo",
    "args": ["fmt"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "on_error"
  },
  {
    "label": "keenpin: 릴리즈 빌드",
    "command": "cargo",
    "args": ["build", "--release"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  }
]
